# Endereço da projeto_pnl_api (sem barra no final). O app chama
# <VITE_API_URL>/fat/sigtap/publico/*
VITE_API_URL=http://localhost:3333

# Token público gerado em Faturamento > Atualizar Tabela > Tokens do app público.
# Ele só abre as rotas de LEITURA do SIGTAP (não serve pra mais nada na API).
VITE_SIGTAP_TOKEN=sgt_coloque_o_token_aqui

# Nome exibido (opcional)
VITE_NOME_INSTITUICAO=

# Endereço público do site (sem barra no final). Usado no build para gerar
# sitemap.xml, robots.txt e os links canônicos das páginas estáticas.
VITE_SITE_URL=https://sigtap.atomiccodes.com.br

# (Opcional) API de onde o build busca os dados das páginas estáticas.
# Use quando a API pública ainda não tiver a rota /sitemap, ex.: http://localhost:3333
# O site publicado continua usando VITE_API_URL.
#BUILD_API_URL=http://localhost:3333

# (Opcional) Verificação de propriedade do site - só o código do "content" da
# meta tag que o Google Search Console / Bing Webmaster Tools mostram.
#VITE_GOOGLE_SITE_VERIFICATION=
#VITE_BING_SITE_VERIFICATION=

# (Opcional) Tempo máximo, em segundos, para a API responder no build (padrão 300)
#BUILD_API_TIMEOUT=300

# (Opcional) npm run deploy: envia o dist/ empacotado por scp e troca a pasta no servidor
#DEPLOY_SSH=usuario@servidor
#DEPLOY_DIR=/var/www/atomic_sigtap/dist
#DEPLOY_PORTA=22
